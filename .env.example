# Local PostgreSQL user for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database for docker compose.
POSTGRES_DB=app

# Host port for backend API.
BACKEND_PORT=8080

# Host port for frontend app.
FRONTEND_PORT=3000

# Browser-visible backend API base URL for frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
